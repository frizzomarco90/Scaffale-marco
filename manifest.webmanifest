{
  "name": "Scaffale",
  "short_name": "Scaffale",
  "description": "La tua libreria di tool HTML, sempre disponibile offline",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1ec",
  "theme_color": "#1e3b2c",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{"name": "file", "accept": ["text/html", ".html", ".htm", "text/plain", "application/octet-stream", "*/*"]}]
    }
  }
}
